[Unit]
Description=site-eyes — Playwright browser-check REST API
After=network-online.target remote-fs.target
Wants=network-online.target
RequiresMountsFor=/mnt/shared

[Service]
Type=simple
WorkingDirectory=/mnt/shared/app
Environment=PATH=/mnt/shared/runtime/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PLAYWRIGHT_BROWSERS_PATH=/mnt/shared/app/.pw-browsers
Environment=SITE_EYES_PORT=8080
Environment=SITE_EYES_WORKERS=3
ExecStart=/mnt/shared/runtime/node/bin/node /mnt/shared/app/server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
