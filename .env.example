# site-eyes configuration — copy to .env and adjust.
# Loaded by `npm start` (node --env-file-if-exists) and by systemd via the
# unit's EnvironmentFile= line. Every variable is optional. Values below are
# what a fresh clone wants; without a .env the code defaults apply
# (SITE_EYES_JOBS=/mnt/shared/jobs, SITE_EYES_TOKEN_FILE=/mnt/shared/app/.token).

# Listen port (binds 0.0.0.0)
SITE_EYES_PORT=8080

# Parallel captures (bounded worker pool)
SITE_EYES_WORKERS=3

# Hard cap per job in ms — the job's browser context is closed when exceeded
SITE_EYES_JOB_TIMEOUT_MS=90000

# Where job artifact directories are written (created on demand)
SITE_EYES_JOBS=./jobs

# Where /check?cache= keeps its small per-request index files (default: cache/ beside the jobs dir)
SITE_EYES_CACHE=./cache

# File holding the bearer token (create it: head -c 32 /dev/urandom | xxd -p -c 64 > .token)
SITE_EYES_TOKEN_FILE=./.token

# Where Playwright keeps Chromium (omit to use Playwright's default cache)
#PLAYWRIGHT_BROWSERS_PATH=./.pw-browsers
